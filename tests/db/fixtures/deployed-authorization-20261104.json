{
  "capturedAt": "2026-11-04",
  "helpers": [
    {
      "acl": "{postgres=X/postgres,authenticated=X/postgres}",
      "name": "can_read_application",
      "owner": "postgres",
      "definition": "CREATE OR REPLACE FUNCTION app_private.can_read_application(p_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'app_private'\nAS $function$\n select exists(select 1 from public.candidate_applications a where a.application_id=p_id and (app_private.is_global_recruitment_reader() or app_private.can_read_position_group(a.group_id)))\n$function$\n"
    },
    {
      "acl": "{postgres=X/postgres,authenticated=X/postgres}",
      "name": "can_read_candidate",
      "owner": "postgres",
      "definition": "CREATE OR REPLACE FUNCTION app_private.can_read_candidate(p_candidate_id text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'app_private'\nAS $function$\n select app_private.is_recruitment_reader() and exists(select 1 from public.candidates c where c.candidate_id=p_candidate_id and (\n app_private.is_profile_admin() or c.created_by=auth.uid() or (exists(select 1 from public.candidate_applications a where a.candidate_id=c.candidate_id) and (\n app_private.is_global_recruitment_reader() or c.home_site=app_private.current_profile_site() or exists(select 1 from public.candidate_applications a where a.candidate_id=c.candidate_id and app_private.can_read_application(a.application_id))))))\n$function$\n"
    },
    {
      "acl": "{postgres=X/postgres,authenticated=X/postgres}",
      "name": "can_read_position_group",
      "owner": "postgres",
      "definition": "CREATE OR REPLACE FUNCTION app_private.can_read_position_group(p_group_id text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select\n    app_private.current_app_role() in ('system_admin', 'admin_recruiter')\n    or exists (\n      select 1\n      from public.document_groups dg\n      where dg.group_id = p_group_id\n        and app_private.can_read_requisition(dg.doc_id)\n    )\n$function$\n"
    },
    {
      "acl": "{postgres=X/postgres,authenticated=X/postgres}",
      "name": "can_read_requisition",
      "owner": "postgres",
      "definition": "CREATE OR REPLACE FUNCTION app_private.can_read_requisition(p_doc_id text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'app_private'\nAS $function$\n select app_private.is_global_recruitment_reader() or exists(select 1 from public.requisitions r where r.doc_id=p_doc_id and app_private.current_app_role()='site_recruiter' and (r.site=app_private.current_profile_site() or lower(btrim(r.person_in_charge)) in (select lower(btrim(p.nickname)) from public.profiles p where p.id=auth.uid()) or lower(btrim(r.person_in_charge)) in (select lower(btrim(p.full_name)) from public.profiles p where p.id=auth.uid()) or exists(select 1 from public.document_groups d where d.doc_id=r.doc_id and app_private.is_group_pic(d.group_id))))\n$function$\n"
    }
  ],
